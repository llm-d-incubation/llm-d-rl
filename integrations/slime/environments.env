# Which environment image slime runs in, and what provisioning installs.
# Framework knowledge, so it lives with the integration - see
# integrations/verl/environments.env for why.

# slime image (Ray head; slime's layout puts the GPUs on the head).
ENGINE_sglang_IMAGE=slimerl/slime:latest
ENGINE_sglang_PY_MODULE=sglang
ENGINE_sglang_MIN_VERSION=

# Cloned at provisioning time. slime is used from PYTHONPATH rather than pip
# installed, and needs Megatron-LM at this tag.
SLIME_REPO=https://github.com/THUDM/slime.git
SLIME_REF=main
MEGATRON_REF=core_v0.16.0

# coding_agent_rl (and slime /generate) need an EPP image with sglanghttp-parser.
# --framework slime-swe-agent reuses this file.
IMG_EPP=ghcr.io/naomieisen/llm-d-router-epp:sglang-parser

