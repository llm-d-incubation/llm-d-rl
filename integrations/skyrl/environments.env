# Which environment image SkyRL runs in, and what provisioning installs.
#
# No separate "environment image with torch/vllm preinstalled" step: SkyRL's
# own docker/Dockerfile is just Ray + uv + system packages
# (anyscale/ray:2.57.0-py312-cu130). torch, vllm, and SkyRL itself are all
# resolved from SkyRL's own uv.lock at `uv run --isolated --extra fsdp ...`
# time. Provisioning clones the repo and warms that uv-managed venv; there is
# no pip install step and no ENGINE_*_MIN_VERSION check (the locked
# vllm/torch versions come from SkyRL's own uv.lock at SKYRL_REF).

# --- SkyRL source ---------------------------------------------------------
SKYRL_REPO=https://github.com/NovaSky-AI/SkyRL.git
SKYRL_REF=58891b2f0e84240da5cc1b3b76f0b91c62b0aef9

# --- Engines this framework is known to work with --------------------------
# ENGINE_vllm_IMAGE is the Ray base image `uv run --isolated` builds its venv
# on top of, not an environment with vllm/torch already installed.
#   HEAD_NUM_CPUS=16: single-pod topology - the head runs the Ray driver, the
#   FSDP trainer actors, and (colocated config) the vLLM engine actors.
#   ALLOC_CONF: CuMemAllocator (sleep/wake) is incompatible with
#   expandable_segments, so it must be False.
ENGINE_vllm_IMAGE=anyscale/ray:2.57.0-py312-cu130
ENGINE_vllm_PY_MODULE=vllm
ENGINE_vllm_MIN_VERSION=
ENGINE_vllm_HEAD_NUM_CPUS=16
ENGINE_vllm_ALLOC_CONF=expandable_segments:False
