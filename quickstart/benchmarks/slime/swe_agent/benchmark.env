# Single source of truth for the slime swe-agent workload.
#
# Every consumer reads its values from here:
#   run_coding_agent_kuberay.sh  sources this file itself, so the launcher
#                                carries no defaults of its own
#   setup_sandbox.sh             sources it to size the runner pool and to
#                                render manifests/sandbox-runner.yaml.tmpl

export PROMPT_DATA=/tmp/slime/data/swe_train.jsonl
export SWE_TRAIN_PROTOCOL=scaleswe

# Workload sizing
# These values control both training and sandbox preparation.
export NUM_ROLLOUT=4  # number of steps
export ROLLOUT_BATCH_SIZE=64
export N_SAMPLES=2

# Sandbox pool
# Maximum number of simultaneously active containers on each runner pod.
export SANDBOX_MAX_PER_POD=16
# Per-sandbox limits.
export SANDBOX_CPUS=2
export SANDBOX_MEM_GI=3
export SANDBOX_PIDS=512
# Extra CPU/Gi on the dind sidecar for dockerd (on top of the sandbox caps).
export DIND_DAEMON_CPUS=4
export DIND_DAEMON_MEM_GI=4
# Node ephemeral storage for one runner's Docker image layers.
export DIND_STORAGE_LIMIT=200Gi

# Agent and evaluation limits
export SWE_AGENT_TIME_BUDGET_SEC=1800
export SWE_EVAL_TIMEOUT_SEC=600

# GPU allocation
# ACTOR_NUM_GPUS + ROLLOUT_NUM_GPUS must equal total GPUs on the kuberay cluster.
export ACTOR_NUM_GPUS=2 # Training GPUs
export ROLLOUT_NUM_GPUS=4 # Inference GPUs
export TP_SIZE=2 # Training tensor parallelism
export ROLLOUT_TP_SIZE=1 # Sets the replica count: ROLLOUT_NUM_GPUS / ROLLOUT_TP_SIZE
export ROLLOUT_DP_SIZE=1 # Tthe DP size inside one SGLang server, not a replica count.


# Sequence lengths
export MAX_CONTEXT_LEN=40960
export MAX_GEN_LEN=8192

# Memory tuning
export LOG_PROBS_CHUNK_SIZE=128
export ROLLOUT_MEM_UTILIZATION=0.6
export ROLLOUT_HICACHE_SIZE=0
export ROLLOUT_CPU_OFFLOAD_GB=0
