# Per-framework platform values: which topology, what to call things, how big.
#
# Framework knowledge that is NOT platform knowledge - the image and the
# framework ref - lives in integrations/<framework>/environments.env instead, and
# deploy.sh sources that too. This file is only the cluster shape.
#
# Adding a framework is a block here plus provision/<framework>.sh. No manifest.

FRAMEWORKS="verl vime slime"

# --- verl: CPU head running the driver, one GPU worker group -------------------
FW_verl_TOPOLOGY=head-workers
FW_verl_HOME=/tmp/verl
FW_verl_ENGINES="vllm sglang"
FW_verl_RAY_VERSION=2.47.1
FW_verl_WORKER_GPUS=8
# /dev/shm holds OffloadingConnector's CPU KV tier, so this caps
# cpu_bytes_to_use x n_replicas, and it counts against the pod memory limit.
FW_verl_DSHM_SIZE=640Gi
FW_verl_PVC_NAME=verl-cache
FW_verl_ENVOY_CONFIG=envoy.yaml
FW_verl_PYTHONPATH=
# Empty means "every variant in configs/epp/variants.yaml". verl has a mode for
# each of them; the single-pod frameworks only route with the burst profile.
FW_verl_EPP_VARIANTS=

# --- vime: one pod, GPUs on the head ------------------------------------------
FW_vime_TOPOLOGY=single-pod
FW_vime_HOME=/tmp/vime
FW_vime_ENGINES="vllm"
FW_vime_RAY_VERSION=2.56.1
FW_vime_WORKER_GPUS=4
FW_vime_PVC_NAME=vime-cache
FW_vime_DSHM_SIZE=64Gi
FW_vime_ENVOY_CONFIG=envoy-shim.yaml
FW_vime_PYTHONPATH=/tmp/pyfix:/tmp/Megatron-LM
FW_vime_EPP_VARIANTS="epp-config.yaml"

# --- slime: one pod, GPUs on the head -----------------------------------------
FW_slime_TOPOLOGY=single-pod
FW_slime_HOME=/tmp/slime
FW_slime_ENGINES="sglang"
FW_slime_RAY_VERSION=2.56.1
FW_slime_HEAD_GPUS=6
FW_slime_DSHM_SIZE=64Gi
FW_slime_ENVOY_CONFIG=envoy-shim.yaml
FW_slime_PYTHONPATH=/tmp/pyfix:/tmp/slime-src:/tmp/Megatron-LM
FW_slime_EPP_VARIANTS="epp-config.yaml"
